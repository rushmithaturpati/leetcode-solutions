class Solution(object):
    def threeSumClosest(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        

        nums.sort()
        ans = nums[0] + nums[1] + nums[2]

        for i in range(len(nums) - 2):
            l = i + 1
            r = len(nums) - 1

            while l < r:
                s = nums[i] + nums[l] + nums[r]

                if abs(s - target) < abs(ans - target):
                    ans = s

                if s == target:
                    return s
                elif s < target:
                    l += 1
                else:
                    r -= 1

        return ans

