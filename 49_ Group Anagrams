class Solution(object):
    def groupAnagrams(self, strs):
        """
        :type strs: List[str]
        :rtype: List[List[str]]
        """
        
        result = {}

        for word in strs:
            key = ''.join(sorted(word))

            if key not in result:
                result[key] = []

            result[key].append(word)

        return list(result.values())
